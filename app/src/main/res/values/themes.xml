<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Base app theme. No action bar; Compose draws all UI. -->
    <style name="Theme.CornerKickPlanner" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:statusBarColor">@color/strong_orange</item>
        <item name="android:navigationBarColor">@color/dark_section</item>
        <item name="android:windowBackground">@color/white</item>
    </style>

    <!-- Custom splash screen (androidx.core:core-splashscreen). Strong orange
         background with the corner-board icon, then hands off to the app theme. -->
    <style name="Theme.CornerKickPlanner.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/ic_launcher_bg</item>
        <item name="windowSplashScreenAnimatedIcon">@mipmap/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.CornerKickPlanner</item>
    </style>

</resources>
