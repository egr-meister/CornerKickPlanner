# -------------------------------------------------------------------------
# Copy this file to `local.properties` and fill in your own values.
# `local.properties` is git-ignored and MUST NEVER be committed.
# -------------------------------------------------------------------------

# Android SDK location (Android Studio usually fills this in automatically).
# sdk.dir=/Users/you/Library/Android/sdk

# football-data.org API v4 token (free tier available at football-data.org).
# If this is left as the placeholder / empty / missing, the app still runs and
# the Match Schedule screen shows built-in demo matches instead of crashing.
FOOTBALL_DATA_API_TOKEN=your_api_token_here

# Base URL for the football-data.org API v4.
FOOTBALL_API_BASE_URL=https://api.football-data.org/v4
